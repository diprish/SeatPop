{
  "name": "@seatpop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./recommend": "./src/recommend/index.ts",
    "./recommend/chips": "./src/recommend/chips.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "ingest": "tsx src/ingest/run.ts",
    "probe": "tsx src/ingest/probe.ts",
    "probe:opl": "tsx src/ingest/probe-opl.ts",
    "seed-sources": "tsx src/ingest/seed.ts",
    "seed:venues": "tsx src/seed-venues/run.ts",
    "clean:descriptions": "tsx src/clean-descriptions/run.ts",
    "repair:months": "tsx src/repair-months/run.ts",
    "seed:registration-windows": "tsx src/seed-registration/run.ts",
    "enrich": "tsx src/enrich/run.ts",
    "eval": "tsx src/eval/run-eval.ts",
    "eval:export": "tsx src/eval/export-csv.ts",
    "eval:import": "tsx src/eval/import-csv.ts",
    "eval:check": "tsx src/eval/check.ts",
    "eval:recommend": "tsx src/recommend/eval-run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seatpop/llm": "*",
    "@seatpop/shared": "*",
    "@xenova/transformers": "^2.17.2",
    "zod": "^4.1.12"
  }
}
