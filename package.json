{
  "name": "seatpop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "worker",
    "packages/shared",
    "packages/llm"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx packages/llm/src/smoke.ts",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
