# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Code defaults are noted in comments; empty values use those defaults.

# Meta Model API (OpenAI-compatible). Required for live model calls.
MODEL_API_KEY=
# Defaults to https://api.meta.ai/v1
MODEL_API_BASE=

# Model ids (defaults are the exact strings from the Models page in dev.meta.ai)
MODEL_SPARK=
MODEL_SPARK_CONTRIBUTOR=
MODEL_WONDER=
MODEL_IMAGE=
MODEL_VOICE=

# Budget guards, in USD (the client throws BudgetExceeded when one is reached)
# Defaults when unset: 135 / 10 / 5
# Note: tier-2 listing extraction always caps the run at $2 (code override).
LLM_MAX_USD_TOTAL=
LLM_MAX_USD_PER_RUN=
LLM_MAX_USD_DAILY_LIVE=

# Client tuning (all optional)
# Per-request timeout in ms. Default: 60000
LLM_TIMEOUT_MS=
# Delay before the single retry, in ms. Default: 500
LLM_RETRY_DELAY_MS=
# Estimated USD held against budgets while one call is in flight, so parallel
# calls cannot collectively overshoot. Default: 0.05
LLM_RESERVE_USD_PER_CALL=
# Content-hash cache directory. Default: .llm-cache
LLM_CACHE_DIR=
# Cost ledger JSONL path. Default: .llm-ledger/llm-calls.jsonl
LLM_LEDGER_PATH=
# Run id for per-run budgets. Default: random per process
LLM_RUN_ID=

# Supabase (ledger mirror + app data; used in later phases)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (used in later phases)
RESEND_API_KEY=

# Ingestion (phase 1)
# Contact URL in the crawler User-Agent. Set this to a real page for you.
INGEST_CONTACT_URL=
# Local state dir for ETag cache and geocode cache. Default: .ingest-state
INGEST_STATE_DIR=
